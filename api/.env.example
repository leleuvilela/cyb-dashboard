# Copy to .env and edit. Loaded automatically by Bun.
PORT=8000

# Location for weather (Open-Meteo, no API key needed).
# Defaults below = Lisbon, Portugal.
LAT=38.7223
LON=-9.1393
# Units: temperature celsius|fahrenheit
TEMP_UNIT=celsius

# Hermes/BMO writes email triage state here. The API reads this JSON and serves
# it to the ESP32 via /dashboard and /emails.
HERMES_DASHBOARD_STATE=/home/leleu/.hermes/dashboard/state.json
# Optional; defaults to <state directory>/actions.
HERMES_DASHBOARD_ACTIONS_DIR=/home/leleu/.hermes/dashboard/actions
EMAIL_MAX_SHOW=5
